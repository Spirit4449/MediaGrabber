# Inside your server { } block (HTTPS strongly recommended)
# Proxy only the private API to localhost
location /api/download {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_buffering off;

    # Optional allowlist (replace with your bot backend IP)
    # allow 127.0.0.1;
    # deny all;
}

location /healthz {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
}

# Add inside the existing HTTPS server for bns.classchats.net.
# Match SHARED_DOWNLOAD_DIR on the production device.
location ^~ /downloads/ {
    alias /var/www/mediagrabber-downloads/;
    autoindex off;
    sendfile on;
    gzip off;
    add_header Content-Disposition "attachment" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "no-store" always;
    if ($uri ~ "(^|/)\.") { return 404; }
    limit_except GET { deny all; }
}
