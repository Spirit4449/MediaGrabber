# Core bot/API
PORT=4000
BIND_HOST=127.0.0.1
SHARED_SECRET=replace-with-a-long-random-secret
BOT_TOKEN=replace-with-your-bot-token
PYTHON_BIN=.venv/bin/python

# Telegram user login; create it with downloader.py --login
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-api-hash
TELEGRAM_SESSION=media_grabber_session
DOWNLOAD_WORKERS=4

# Oversized originals (configure Nginx before enabling public links)
PUBLIC_DOWNLOAD_BASE_URL=
SHARED_DOWNLOAD_DIR=
DOWNLOAD_RETENTION_HOURS=72
BOT_MAX_UPLOAD_MB=49
BOT_SEND_COMPRESSED_COPY=false

# Scheduled audio sync: website upload is disabled in this template.
BNS_DISABLE_SITE_UPLOAD=true
BNS_SITE_URL=
BNS_ADMIN_USERNAME=
BNS_ADMIN_PASSWORD=
TELEGRAM_NOTIFY_CHAT_ID=

# Moments with Mahant Swami import (moments_sync.py). Uses the BNS_SITE_URL admin login above.
MOMENTS_CHANNEL_ID=2074676830
# Seconds each run waits for today's post to be processed on the site.
MOMENTS_WAIT_SECONDS=600
# Sent to the site; Cloudflare blocks Python's default User-Agent (error 1010).
# MOMENTS_USER_AGENT=Mozilla/5.0 (compatible; MediaGrabber-moments/1.0)

# Recovery workers (no new dependencies). Times use this explicit timezone.
BNS_TIMEZONE=America/New_York
BNS_CHECK_INTERVAL_SECONDS=900
BNS_RUN_TIMEOUT_SECONDS=1800
BNS_ALERT_AFTER=18:00
BOT_POLL_TIMEOUT_SECONDS=300
DOWNLOAD_TIMEOUT_SECONDS=1800
# Set NODE_BIN to an absolute Node path if PM2's startup PATH does not include it.
# NODE_BIN=/usr/bin/node
